{
  "name": "breadboard-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run validate",
    "validate": "tsx scripts/validate-challenges.ts",
    "size": "tsx scripts/check-bundle-size.ts",
    "test:unit": "vitest run",
    "test:slow": "TLINE_HEAVY=1 vitest run src/core/analysis/tlineChapter.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -b && npm run lint && npm run format:check && npm test && vite build && npm run size",
    "e2e": "node scripts/e2e.cjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "canvas-confetti": "^1.9.3",
    "harmonyos-sans-webfont-splitted": "1.2.1",
    "lucide-react": "1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.182.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "axe-core": "4.11.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "1.63.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
