{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://breadboard-lab.local/schema/challenge.schema.json",
  "title": "Breadboard Lab challenge (breadboard-challenge/1)",
  "description": "Lesson / challenge file for Breadboard Lab. Mirrors src/core/challenge.ts (parseChallenge). See docs/CHALLENGE_FORMAT.md.",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "components"
  ],
  "anyOf": [
    {
      "required": [
        "connections"
      ]
    },
    {
      "required": [
        "nets"
      ]
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "breadboard-challenge/1",
      "description": "Format identifier. Must be exactly \"breadboard-challenge/1\"."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Unique id: letters, digits, - and _."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "lesson",
        "challenge"
      ],
      "default": "challenge",
      "description": "lesson = guided (steps); challenge = solve it yourself (hints)."
    },
    "level": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 1,
      "description": "Difficulty 1–5 (rounded and clamped)."
    },
    "phase": {
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "Course phase (docs/ROADMAP.md) this experiment belongs to: 1 basic laws & equivalence, 2 methods/theorems/op-amps, 3 transients, 4 AC, 5 MCU peripheral circuits. Omit for the original intro set. The challenge list groups challenges by phase. File names: phase n uses 2NN with NN in (n−1)·20 … (n−1)·20+19 (phase 5: 280–299)."
    },
    "summary": {
      "type": "string",
      "description": "One-line summary shown in the list."
    },
    "description": {
      "description": "Teaching text. Plain text; \\n for line breaks. An array of strings is joined with \\n.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lang": {
      "enum": [
        "zh",
        "en"
      ],
      "default": "zh",
      "description": "Language of the top-level text fields (title, summary, description, concepts, steps, hints, test names). Default \"zh\"."
    },
    "i18n": {
      "type": "object",
      "description": "Translations of the text fields, keyed by language. Used when the UI is in that language; anything missing falls back to the top-level (base) text.",
      "properties": {
        "zh": {
          "$ref": "#/definitions/translation"
        },
        "en": {
          "$ref": "#/definitions/translation"
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "description": "Target circuit components (logical). Wires are NOT components.",
      "items": {
        "$ref": "#/definitions/component"
      }
    },
    "connections": {
      "type": "array",
      "description": "Each item = a group of terminals that are electrically connected (one node). Groups sharing a terminal are merged.",
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/pinRef"
        }
      }
    },
    "nets": {
      "type": "array",
      "description": "Named nodes. Same meaning as connections, but with a name (shown in messages, e.g. VCC / GND / VOUT).",
      "items": {
        "type": "object",
        "required": [
          "pins"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "pins": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/pinRef"
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/test"
      }
    },
    "measurements": {
      "type": "array",
      "description": "Optional measurement questions (lab stage 2): after the circuit check passes the student types what THEIR board reads. The expected value is simulated on the student's own board (their part values), never written in the file. See docs/CHALLENGE_FORMAT.md § Measurement questions.",
      "items": {
        "$ref": "#/definitions/measurement"
      }
    },
    "compare": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "The expected readings / worked comparison, shown only after every required measurement question is answered (keep such numbers out of the description and hints). String or array of lines."
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "highlight": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/hole"
                }
              },
              "check": {
                "description": "Lesson step check (§7.1): what must be on the board for this step to count as done. One entry or an array: a layout part (type + pins/at + settings to match; any hole on the same strip counts), { probe: { red, black } } multimeter probes, { empty: [holes] }, or { scope: { tdiv, vdiv1, vdiv2 } }.",
                "oneOf": [
                  {
                    "$ref": "#/definitions/stepCheck"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/stepCheck"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "prereq": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "description": "Ids of built-in lessons to do first; shown as links at the top of the task panel."
    },
    "solution": {
      "$ref": "#/definitions/layout"
    },
    "start": {
      "$ref": "#/definitions/layout"
    },
    "options": {
      "type": "object",
      "properties": {
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "default": 0.05,
          "description": "Relative tolerance for component values (0.05 = ±5%)."
        },
        "allowExtraComponents": {
          "type": "boolean",
          "default": false,
          "description": "If true, extra parts on the board are not errors."
        }
      }
    }
  },
  "definitions": {
    "translation": {
      "type": "object",
      "description": "Translated text. steps / hints / tests are matched to the top-level arrays by position and must have the same length.",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "description": "Same as the top-level description: a string, or an array of lines joined with \\n.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Same length and order as the top-level hints; ignored if the length differs."
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Step texts only, same count and order as the top-level steps. Highlighted holes come from the top-level steps."
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test names only, same order as the top-level tests."
        },
        "compare": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Translated compare text."
        },
        "measurements": {
          "type": "array",
          "description": "Same count and order as the top-level measurements: translated ask / explain / choices.",
          "items": {
            "type": "object",
            "properties": {
              "ask": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "explain": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "value": {
      "description": "Number or engineering string: 330, \"330\", \"4.7k\", \"4k7\", \"1M\", \"100nF\", \"any\".",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^(any|\\s*-?\\d*\\.?\\d+(e-?\\d+)?\\s*[pnuµmkKMG]?\\s*(ohms?|Ω|Hz|F|V|A|H)?\\s*|\\d+[pnuµmkKMG]\\d+\\s*(ohms?|Ω|Hz|F|V|A|H)?)$"
        }
      ]
    },
    "ledColor": {
      "enum": [
        "red",
        "yellow",
        "green",
        "blue",
        "white",
        "any"
      ]
    },
    "wireColor": {
      "description": "Jumper wire colour: a name the parser knows (src/core/challenge.ts WIRE_NAMES) or a hex colour.",
      "oneOf": [
        {
          "enum": [
            "red",
            "black",
            "blue",
            "green",
            "yellow",
            "white",
            "orange"
          ]
        },
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        }
      ]
    },
    "batteryVariant": {
      "enum": [
        "9V",
        "2xAA",
        "3xAA",
        "4xAA",
        "CR2032"
      ]
    },
    "hole": {
      "type": "string",
      "pattern": "^([a-j]|tp|tn|bp|bn)([1-9]|[12][0-9]|30)$",
      "description": "Main area a1–j30; rails tp1–tp30 (top +), tn1–tn30 (top −), bp1–bp30 (bottom +), bn1–bn30 (bottom −)."
    },
    "pinRef": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.[^.]+$",
      "description": "\"REF.pin\", e.g. \"R1.1\", \"LED1.anode\", \"V1.+\", \"SW1.2\", \"RV1.2\", \"S1.com\", \"U1.outA\", \"U1.inA-\", \"U1.v+\", \"FG1.+\", \"AM1.-\"."
    },
    "props": {
      "type": "object",
      "properties": {
        "resistance": {
          "$ref": "#/definitions/value"
        },
        "value": {
          "$ref": "#/definitions/value"
        },
        "voltage": {
          "$ref": "#/definitions/value"
        },
        "capacitance": {
          "$ref": "#/definitions/value"
        },
        "currentLimit": {
          "$ref": "#/definitions/value"
        },
        "wiper": {
          "$ref": "#/definitions/value"
        },
        "color": {
          "$ref": "#/definitions/ledColor"
        },
        "variant": {
          "$ref": "#/definitions/batteryVariant"
        },
        "pressed": {
          "type": "boolean"
        },
        "position": {
          "enum": [
            "a",
            "b"
          ]
        },
        "inductance": {
          "$ref": "#/definitions/value",
          "description": "Inductor value in henries, e.g. \"10m\" or \"10mH\"."
        },
        "frequency": {
          "$ref": "#/definitions/value",
          "description": "function_gen frequency in Hz, e.g. 1000, \"1k\", \"1kHz\"."
        },
        "amplitude": {
          "$ref": "#/definitions/value",
          "description": "function_gen amplitude, PEAK volts (Vpp = 2 × amplitude)."
        },
        "offset": {
          "$ref": "#/definitions/value",
          "description": "function_gen DC offset in volts (may be negative)."
        },
        "waveform": {
          "enum": [
            "sine",
            "square",
            "triangle",
            "any"
          ]
        },
        "channel": {
          "enum": [
            1,
            2
          ],
          "description": "scope_probe channel (layouts only)."
        },
        "modes": {
          "$ref": "#/definitions/pinModes"
        },
        "usb": {
          "type": "boolean",
          "description": "Dev board: virtual USB cable plugged in (default true)."
        },
        "beta": {
          "type": "number",
          "description": "npn current gain β (default 150)."
        },
        "model": {
          "enum": [
            "IRLZ44N",
            "IRF540N"
          ],
          "description": "nmos model: IRLZ44N logic level (Vth 1.5 V) or IRF540N standard (Vth 3 V)."
        },
        "lux": {
          "type": "number",
          "minimum": 0,
          "description": "ldr light level (lux)."
        },
        "temperature": {
          "type": "number",
          "description": "ntc temperature (°C)."
        },
        "props": {
          "type": "object",
          "description": "Layout parts only: properties as an object (needed for dev boards, whose top-level \"pins\" are hole positions).",
          "$ref": "#/definitions/props"
        }
      }
    },
    "component": {
      "allOf": [
        {
          "$ref": "#/definitions/props"
        },
        {
          "type": "object",
          "required": [
            "ref",
            "type"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "description": "Unique reference, e.g. R1, LED1, V1."
            },
            "type": {
              "enum": [
                "resistor",
                "led",
                "diode",
                "capacitor",
                "pushbutton",
                "switch",
                "potentiometer",
                "battery",
                "bench_supply",
                "power_module",
                "dc_source",
                "inductor",
                "ammeter",
                "opamp",
                "function_gen",
                "esp32_devkit",
                "stm32_bluepill",
                "mcu",
                "npn",
                "nmos",
                "relay",
                "motor",
                "buzzer",
                "ldo",
                "ldr",
                "ntc"
              ],
              "description": "dc_source matches any battery / bench_supply / power_module (with the same voltage if given). opamp = one LM358 (logical pins outA, inA-, inA+, v-, inB+, inB-, outB, v+; halves A/B are interchangeable when grading). scope_probe is NOT allowed here (use \"scope\" tests). An ammeter not listed in the target is treated as a wire on the student's board. Phase 5: esp32_devkit / stm32_bluepill dev boards (or the generic mcu = either board); their pins are power pins 3V3, 5V, GND, EN (NRST) or logical roles GPIO_OUT<n>, GPIO_IN<n>, ADC<n>, PWM<n>, GPIO_FT<n>, IO<n> (each matches any free physical GPIO with that capability), or exact physical pins (GPIO2, PA0). npn pins e,b,c; nmos g,d,s; relay coil1,coil2,com,nc,no; motor +,-; buzzer +,-; ldo gnd,out,in; ldr / ntc 1,2."
            }
          }
        }
      ]
    },
    "test": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "set": {
          "type": "object",
          "description": "Temporary property overrides per component ref, e.g. {\"SW1\": {\"pressed\": true}}, {\"S1\": {\"position\": \"b\"}}, {\"RV1\": {\"wiper\": 0.2}}. Generators: {\"FG1\": {\"waveform\": \"square\", \"frequency\": 100, \"amplitude\": 2.5, \"offset\": 2.5}}. Dev boards: {\"U1\": {\"modes\": {\"GPIO_OUT1\": \"out_low\"}, \"usb\": false}}; sensors: {\"LDR1\": {\"lux\": 1000}}, {\"RT1\": {\"temperature\": 50}}.",
          "additionalProperties": {
            "$ref": "#/definitions/props"
          }
        },
        "expect": {
          "type": "object",
          "description": "ref -> \"on\" | \"off\": LED lit (> 0.5 mA, average under AC), relay energised, motor running, buzzer sounding.",
          "additionalProperties": {
            "enum": [
              "on",
              "off"
            ]
          }
        },
        "voltages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pin"
            ],
            "properties": {
              "pin": {
                "$ref": "#/definitions/pinRef"
              },
              "ref": {
                "$ref": "#/definitions/pinRef",
                "description": "Reference terminal. Omitted = GND (the − of the first power source)."
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "description": "DC voltage checks; with a function generator present the steady-state AVERAGE is used."
        },
        "currents": {
          "type": "array",
          "description": "Current checks in amps. el = ammeter (its reading, in at +) or a resistor / inductor (pin 1 → 2), LED / diode (anode → cathode), source / generator (out of +). Also npn (collector current), nmos (drain current), relay (coil current), motor, buzzer, ldo (output current), ldr, ntc.",
          "items": {
            "type": "object",
            "required": [
              "el"
            ],
            "properties": {
              "el": {
                "type": "string",
                "description": "Component ref (alias: meter)."
              },
              "meter": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "dc",
                  "rms"
                ],
                "default": "dc",
                "description": "dc = DC / average current; rms = true RMS."
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "scope": {
          "type": "array",
          "description": "Oscilloscope measurements of V(pin) − V(ref) over the periodic steady state.",
          "items": {
            "type": "object",
            "required": [
              "pin",
              "measure"
            ],
            "properties": {
              "pin": {
                "$ref": "#/definitions/pinRef"
              },
              "ref": {
                "$ref": "#/definitions/pinRef",
                "description": "Reference terminal. Omitted = GND."
              },
              "measure": {
                "enum": [
                  "vpp",
                  "vmax",
                  "vmin",
                  "vavg",
                  "vrms",
                  "freq",
                  "phase",
                  "gain",
                  "rise",
                  "fall"
                ],
                "description": "vpp/vmax/vmin/vavg/vrms in V; freq in Hz; phase in degrees (−180..180, positive = pin leads vs); gain = |fundamental(pin)| / |fundamental(vs)|. rise / fall = 10 %→90 % / 90 %→10 % edge time in seconds (averaged over the edges in the window)."
              },
              "vs": {
                "$ref": "#/definitions/pinRef",
                "description": "Required for phase and gain: the pin to compare with (relative to vsref, or to ref when vsref is omitted)."
              },
              "vsref": {
                "$ref": "#/definitions/pinRef",
                "description": "Optional reference for the vs signal (default: same as ref). Compares V(pin) − V(ref) with V(vs) − V(vsref), e.g. a floating V_L against V_R."
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "if": {
              "properties": {
                "measure": {
                  "enum": [
                    "phase",
                    "gain"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "vs"
              ]
            }
          }
        },
        "gpio": {
          "type": "array",
          "description": "Dev-board pin checks. read = the logic level a digital input reads (high / low / floating); measure = voltage (V vs the board's GND), current (A out of the pin's driver / pull, negative = sinking), adc (12-bit raw count), adc_v (V).",
          "items": {
            "type": "object",
            "required": [
              "pin"
            ],
            "properties": {
              "pin": {
                "$ref": "#/definitions/pinRef"
              },
              "read": {
                "enum": [
                  "high",
                  "low",
                  "floating"
                ]
              },
              "measure": {
                "enum": [
                  "voltage",
                  "current",
                  "adc",
                  "adc_v"
                ]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "regions": {
          "type": "object",
          "description": "Operating region per transistor ref: npn cutoff / active / saturation; nmos off / ohmic / saturation.",
          "additionalProperties": {
            "enum": [
              "cutoff",
              "active",
              "saturation",
              "off",
              "ohmic"
            ]
          }
        }
      }
    },
    "layoutPart": {
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "wire"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "color": {
                "$ref": "#/definitions/wireColor"
              },
              "props": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "#/definitions/wireColor"
                  }
                }
              }
            }
          },
          "else": {
            "$ref": "#/definitions/props"
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "wire",
                "resistor",
                "led",
                "diode",
                "capacitor",
                "pushbutton",
                "switch",
                "potentiometer",
                "battery",
                "bench_supply",
                "power_module",
                "inductor",
                "ammeter",
                "opamp",
                "function_gen",
                "scope_probe",
                "esp32_devkit",
                "stm32_bluepill",
                "npn",
                "nmos",
                "relay",
                "motor",
                "buzzer",
                "ldo",
                "ldr",
                "ntc"
              ]
            },
            "ref": {
              "type": "string"
            },
            "pins": {
              "type": "object",
              "description": "Physical pin -> hole. wire a/b; resistor 1/2; led & diode anode/cathode; capacitor 1/2; battery & bench_supply +/-; pushbutton 1a/2a/1b/2b; switch a/com/b; potentiometer 1/2/3; power_module +t/-t/+b/-b. inductor 1/2; ammeter & function_gen +/-; scope_probe tip/gnd; opamp 1..8. Phase 5: npn e/b/c, nmos g/d/s, ldo gnd/out/in (3 adjacent columns, use \"at\"); relay coil1/coil2/com/nc/no (use \"at\" in row e); motor & buzzer +/-; ldr & ntc 1/2; dev boards: use \"at\" (ESP32 row b, Blue Pill row c = the top-left GND pin) and put pin modes in \"props\": {\"modes\": {...}}.",
              "additionalProperties": {
                "$ref": "#/definitions/hole"
              }
            },
            "at": {
              "$ref": "#/definitions/hole",
              "description": "Footprint anchor for pushbutton / switch / potentiometer / power_module / opamp (opamp: pin 1, must be in row e) instead of pins. Dev boards: esp32_devkit anchor in row b (19 columns, lower header in row i); stm32_bluepill anchor in row c (20 columns, lower header in row g). npn / nmos / ldo: the first leg (E / G / GND); relay: coil1 in row e."
            },
            "color": {
              "type": "string",
              "description": "LED colour (red / yellow / green / blue / white), or for type \"wire\" the jumper colour (red / black / blue / green / yellow / white / orange, or \"#rrggbb\")."
            },
            "props": {
              "$ref": "#/definitions/props",
              "description": "Alternative to flat properties."
            }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": [
        "parts"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/layoutPart"
          }
        }
      }
    },
    "pinMode": {
      "enum": [
        "out_high",
        "out_low",
        "input",
        "input_pullup",
        "input_pulldown",
        "pwm",
        "adc"
      ]
    },
    "pinModes": {
      "type": "object",
      "description": "Dev-board pin modes by pin name (physical, e.g. GPIO2 / PA0, or logical, e.g. GPIO_OUT1): a mode string or { mode, duty (0–100 %), frequency (Hz) }. Unlisted pins are plain inputs.",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/pinMode"
          },
          {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "$ref": "#/definitions/pinMode"
              },
              "duty": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "frequency": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "openDrain": {
                "type": "boolean",
                "description": "Open-drain output (out_high / out_low / pwm): the high state releases the pin (I²C style, needs a pull-up)."
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "id",
        "ask"
      ],
      "description": "Exactly one of current / voltage / scope / formula / choices.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Identifier, unique in the file; formulas refer to it. Not pi, e, sqrt, ln, log, exp."
        },
        "ask": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "What to read and where (meter, leads, probe). The reading's state comes from set and is shown automatically."
        },
        "explain": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Shown after a correct answer."
        },
        "current": {
          "type": "string",
          "description": "Ref whose current is read (ammeter reading, or current from a part's first terminal to its second). Default unit mA."
        },
        "mode": {
          "enum": [
            "dc",
            "rms"
          ],
          "description": "With current: average (default) or true RMS."
        },
        "voltage": {
          "$ref": "#/definitions/pinRef",
          "description": "Multimeter red lead; with ref the black lead (default GND). DC, or the average with a generator. Default unit V."
        },
        "scope": {
          "enum": [
            "vpp",
            "vmax",
            "vmin",
            "vavg",
            "vrms",
            "freq",
            "phase",
            "gain",
            "rise",
            "fall",
            "ring"
          ],
          "description": "Scope measurement of pin (vs ref). ring = frequency of a damped oscillation after each edge. Default units: V, Hz, °, ms (rise/fall), none (gain)."
        },
        "pin": {
          "$ref": "#/definitions/pinRef"
        },
        "ref": {
          "$ref": "#/definitions/pinRef"
        },
        "vs": {
          "$ref": "#/definitions/pinRef"
        },
        "vsref": {
          "$ref": "#/definitions/pinRef"
        },
        "solve": {
          "type": "object",
          "required": [
            "el",
            "from",
            "to",
            "value"
          ],
          "description": "Sweep generator el's frequency over [from, to] for the frequency where the scope measure equals value; the answer is that frequency (Hz). E.g. resonance: phase = 0.",
          "properties": {
            "el": {
              "type": "string"
            },
            "from": {
              "$ref": "#/definitions/value"
            },
            "to": {
              "$ref": "#/definitions/value"
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "formula": {
          "type": "string",
          "description": "Arithmetic on the student's own accepted answers to EARLIER questions, by id: \"uoc / isc\", \"tr / ln(9)\", \"u9 * i9\". Opens once those are answered."
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          },
          "description": "Multiple choice (with correct)."
        },
        "correct": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "description": "Shown next to the box; a prefixed unit (\"mA\", \"kHz\", \"µs\") means a bare number is read in it."
        },
        "tol": {
          "type": "number",
          "minimum": 0,
          "description": "Relative tolerance. Defaults: 0.03 (meters, scope amplitudes, freq), 0.08 (rise / fall / ring read off the grid), 0.02 (formula: arithmetic on the student's own numbers)."
        },
        "tolAbs": {
          "type": "number",
          "minimum": 0,
          "description": "Absolute tolerance in SI units for readings near zero. Defaults: 5 mV (voltage, scope amplitudes), 1 µA (current)."
        },
        "tolDeg": {
          "type": "number",
          "minimum": 0,
          "default": 2,
          "description": "Phase tolerance in degrees."
        },
        "predict": {
          "type": "boolean",
          "description": "Ask for a prediction first; the reading box opens once one is written. Shows predicted vs measured with the percent difference."
        },
        "optional": {
          "type": "boolean",
          "description": "Not needed to complete the challenge."
        },
        "stated": {
          "type": "boolean",
          "description": "The lab text states a number equal to this reading on purpose (a model parameter or spec limit the reading verifies); the validator's answer-leak check skips this question."
        },
        "set": {
          "type": "object",
          "description": "The state the reading is taken in, as in tests (button, switch, knob, generator, supply voltage, pin modes). The expected value is computed with it; the UI names it and warns when the board isn't in it.",
          "additionalProperties": {
            "$ref": "#/definitions/props"
          }
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/definitions/value"
          },
          "description": "Author's sanity range [min, max] in SI units: the validator checks the reference solution's reading falls inside."
        }
      },
      "additionalProperties": false
    },
    "stepCheck": {
      "oneOf": [
        {
          "$ref": "#/definitions/layoutPart"
        },
        {
          "type": "object",
          "required": [
            "probe"
          ],
          "properties": {
            "probe": {
              "type": "object",
              "properties": {
                "red": {
                  "$ref": "#/definitions/hole"
                },
                "black": {
                  "oneOf": [
                    {
                      "$ref": "#/definitions/hole"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "required": [
            "empty"
          ],
          "properties": {
            "empty": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/hole"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "type": "object",
              "properties": {
                "tdiv": {
                  "$ref": "#/definitions/value"
                },
                "vdiv1": {
                  "$ref": "#/definitions/value"
                },
                "vdiv2": {
                  "$ref": "#/definitions/value"
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    }
  }
}
